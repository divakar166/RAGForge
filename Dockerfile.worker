FROM ghcr.io/astral-sh/uv:latest AS builder
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group worker --no-install-project

COPY app/ ./app/
RUN uv sync --frozen --no-dev --group worker

FROM python:3.12-slim
WORKDIR /app
COPY --from=builder /app/.venv ./.venv
COPY --from=builder /app/app ./app
ENV PATH="/app/.venv/bin:$PATH"
RUN groupadd -r app && useradd -r -g app -d /app -s /sbin/nologin app && chown -R app:app /app
USER app
CMD ["celery", "-A", "app.workers.tasks", "worker", "--loglevel=info"]
