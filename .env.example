APP_NAME=RAGForge
DEBUG=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here
SUPABASE_MODE=true

# Redis (local Docker container)
REDIS_URL=redis://redis:6379/0

# Qdrant Cloud
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=documents
QDRANT_CLOUD_INFERENCE=true

# Auth / JWT
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM (OpenAI-compatible — used for chat, not embeddings)
# Embeddings use Qdrant Cloud inference (all-minilm-l6-v2) when QDRANT_CLOUD_INFERENCE=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
SPARSE_MODEL=bm25
EMBEDDING_DIM=384

# RAG Pipeline
CHUNK_DEFAULT_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=50
TOP_K_RERANK=5
RERANKER_ENABLED=true

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,docx,txt,md,html

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Langfuse (tracing, opt-in)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# RAGAS (evaluation)
RAGAS_ENABLED=false
